    def _auto_detect_log(self):
        log_dir = os.path.expandvars(r"%USERPROFILE%\AppData\LocalLow\VRChat\VRChat")
        files = glob.glob(os.path.join(log_dir, "output_log_*.txt"))
        if files:
            latest = max(files, key=os.path.getmtime)
            self.entry_log_path.delete(0, "end")
            self.entry_log_path.insert(0, latest)
            self.log(f"最新ログ検出: {os.path.basename(latest)}")

    def _focus_and_center_mouse(self):
        hwnd = ctypes.windll.user32.FindWindowW(None, "VRChat")
        if hwnd:
            ctypes.windll.user32.SetForegroundWindow(hwnd)
            time.sleep(0.1)
            rect = wintypes.RECT()
            ctypes.windll.user32.GetWindowRect(hwnd, ctypes.byref(rect))
            center_x = rect.left + (rect.right - rect.left) // 2
            center_y = rect.top + (rect.bottom - rect.top) // 2
            try: pydirectinput.moveTo(center_x, center_y)
            except Exception: pass
            time.sleep(0.05)
            return True
        return False

    def _safe_sleep(self, seconds, check_stop=True):
        if not check_stop: return True
        return not self.stop_event.wait(seconds)

    def _release_all_inputs(self):
        for key in ('w', 'a', 's', 'd'): pydirectinput.keyUp(key)
        pydirectinput.mouseUp()

    def _global_watcher_worker(self):
        f = None
        current_log = ""
        while True:
            if self.is_running or not self.chk_auto_exec_var.get():
                if f:
                    f.close()
                    f = None
                time.sleep(1.0)
                continue

            log_path = self.entry_log_path.get().strip()
            if not log_path or not os.path.exists(log_path):
                time.sleep(1.0)
                continue

            if not f or current_log != log_path:
                try:
                    f = open(log_path, "r", encoding="utf-8", errors="ignore")
                    f.seek(0, os.SEEK_END)
                    current_log = log_path
                except Exception:
                    pass

            if f:
                try:
                    lines = f.readlines()
                    for line in lines:
                        if self.RECOVERY_KEYWORD in line and self.FALSE_POSITIVE_1 not in line and self.FALSE_POSITIVE_2 not in line:
                            self.log("【自動復帰】Verified を検知したため、マクロを起動します。")
                            self.after(0, self.start_macro)
                            f.seek(0, os.SEEK_END)
                            break
                except Exception:
                    pass
            time.sleep(1.0)

    def start_macro(self):
        log_path = self.entry_log_path.get().strip()
        if not os.path.exists(log_path):
            messagebox.showerror("エラー", "ログファイルが存在しません。")
            return
        try:
            self.p_wait = float(self.val_wait.get())
            self.p_fwd = float(self.val_forward.get())
            self.p_left = float(self.val_left.get())
            self.p_t_left = float(self.val_test_left.get())
            self.p_t_right = float(self.val_test_right.get())
            self.p_punish_t = float(self.val_punish_thresh.get())
            self.p_8page_t = float(self.val_8page_thresh.get())
            self.p_back_time = float(self.val_back_time.get())
            self.p_max_recovery = float(self.val_max_recovery.get())
        except ValueError:
            messagebox.showerror("エラー", "時間設定には数値を入力してください。")
            return

        self._save_config()
        self.is_running = True
        self.is_standby = False
        self.stop_event.clear()
        self.last_valid_time = time.time()
        
        self.btn_start.configure(state="disabled")
        self.btn_stop.configure(state="normal")
        self.log("=== 実行を開始しました ===")

    def stop_macro(self):
        if not self.is_running: return
        self.log("停止リクエストを受信。停止中...")
        self.is_running = False
        self.stop_event.set()
        self._release_all_inputs()
        self.btn_start.configure(state="normal")
        self.btn_stop.configure(state="disabled")
        self.log("=== 停止しました ===")

    def _integrated_monitor_worker(self):
        current_log_path = ""
        f = None
        last_dir_scan = 0
        
        while not self.stop_event.is_set():
            time.sleep(0.5)
            
            target_log = self.entry_log_path.get().strip()
            
            if self.chk_auto_exec_var.get() and time.time() - last_dir_scan > 5.0:
                last_dir_scan = time.time()
                log_dir = os.path.expandvars(r"%USERPROFILE%\AppData\LocalLow\VRChat\VRChat")
                files = glob.glob(os.path.join(log_dir, "output_log_*.txt"))
                if files:
                    latest_log = max(files, key=os.path.getmtime)
                    if target_log and latest_log != target_log and os.path.getmtime(latest_log) > os.path.getmtime(target_log):
                        self.entry_log_path.delete(0, "end")
                        self.entry_log_path.insert(0, latest_log)
                        target_log = latest_log
                        self.log(f"【自動追従】新しいログファイルを検出しました: {os.path.basename(latest_log)}")

            if not target_log or not os.path.exists(target_log): continue
            
            if not f or current_log_path != target_log:
                if f: f.close()
                try:
                    f = open(target_log, "r", encoding="utf-8", errors="ignore")
                    f.seek(0, os.SEEK_END)
                    current_log_path = target_log
                except Exception:
                    f = None
                    continue

            found_round = False
            found_verified = False
            
            while True:
                line = f.readline()
                if not line: break
                if self.TARGET_KEYWORD in line: found_round = True
                if self.RECOVERY_KEYWORD in line and self.FALSE_POSITIVE_1 not in line and self.FALSE_POSITIVE_2 not in line:
                    found_verified = True

            if found_verified:
                if self.is_standby:
                    if self.chk_auto_exec_var.get():
                        self.is_standby = False 
                        self.log("【ACTIVE】自動復帰モードにより、待機から復帰しました。")
                        self.last_valid_time = time.time()
                    else:
                        self.log("【STANDBY】自動復帰がOFFのため、待機状態を継続します。")
                elif not self.is_running and self.chk_auto_exec_var.get():
                    self.log("【自動起動】Verified を検知したため、マクロを起動します。")
                    self.after(0, self.start_macro)
                    found_verified = False

            if not self.is_running: continue

            if not self.is_standby and self.chk_standby_var.get():
                if time.time() - self.last_valid_time >= 60.0:
                    self.is_standby = True
                    self.log("【STANDBY】60秒間 Round was valid. がないため一時停止し、自動復帰動作を開始します。")
                    threading.Thread(target=self._execute_recovery_action, daemon=True).start()

            if not self.is_standby and found_round:
                self.last_valid_time = time.time()
                threading.Thread(target=self._execute_main_action, daemon=True).start()

    def _execute_recovery_action(self):
        if not self.action_lock.acquire(blocking=False): return
        try:
            self._focus_and_center_mouse()
            self.log("自動復帰動作(後退)を実行します...")
            pydirectinput.keyDown('s')
            self._safe_sleep(self.p_back_time, self.is_running)
            pydirectinput.keyUp('s')
            self._safe_sleep(0.1, self.is_running)
            
            rec_start = time.time()
            is_right = True
            self.log("自動復帰動作(左右Use連打)を開始します。")
            
            while time.time() - rec_start < self.p_max_recovery and self.is_running and self.is_standby:
                current_key = 'd' if is_right else 'a'
                pydirectinput.keyDown(current_key)
                
                step_end = time.time() + 3.0
                while time.time() < step_end and self.is_running and self.is_standby:
                    pydirectinput.mouseDown()
                    self._safe_sleep(0.05, self.is_running)
                    pydirectinput.mouseUp()
                    self._safe_sleep(0.1, self.is_running)
                
                pydirectinput.keyUp(current_key)
                is_right = not is_right
                
            self.log("自動復帰動作が終了、または中断されました。")
        finally:
            self._release_all_inputs()
            self.action_lock.release()

    def _execute_main_action(self):
        if not self.action_lock.acquire(blocking=False): return
        try:
            if self.chk_main_var.get():
                self.log(f"検知: '{self.TARGET_KEYWORD}' -> 自動ボタン押下開始")
                if not self._safe_sleep(self.p_wait, self.is_running): return
                
                self._focus_and_center_mouse()
                
                self.log("前方(W)へ移動")
                pydirectinput.keyDown('w')
                if not self._safe_sleep(self.p_fwd, self.is_running): return
                pydirectinput.keyUp('w')
                if not self._safe_sleep(0.1, self.is_running): return
                
                self.log("左方(A)へ移動")
                pydirectinput.keyDown('a')
                if not self._safe_sleep(self.p_left, self.is_running): return
                pydirectinput.keyUp('a')
                if not self._safe_sleep(0.2, self.is_running): return
                
                self.log("オブジェクトをUse (画面中央をクリック)")
                pydirectinput.mouseDown()
                self._safe_sleep(0.1, self.is_running)
                pydirectinput.mouseUp()
                self.log("自動ボタン押下完了。")

            if self.chk_speed_var.get() and self.is_running:
                self.log("【速度テスト】左右移動を開始します...")
                self.is_testing_speed = True
                self.max_velocity_during_test = 0.0
                
                pydirectinput.keyDown('a')
                if not self._safe_sleep(self.p_t_left, self.is_running): return
                pydirectinput.keyUp('a')
                if not self._safe_sleep(0.1, self.is_running): return
                
                pydirectinput.keyDown('d')
                if not self._safe_sleep(self.p_t_right, self.is_running): return
                pydirectinput.keyUp('d')
                if not self._safe_sleep(0.1, self.is_running): return
                
                self.is_testing_speed = False
                self.log(f"テスト終了。最大速度: {self.max_velocity_during_test:.3f}")
                
                v_max = self.max_velocity_during_test
                t1 = self.p_punish_t
                t2 = self.p_8page_t
                matched = None
                
                if v_max < t1 and v_max < t2: matched = "punish" if t1 < t2 else "8page"
                elif v_max < t1: matched = "punish"
                elif v_max < t2: matched = "8page"
                
                if matched == "punish":
                    self.log(f"【警告】速度がパニッシュ閾値({t1})未満です。")
                    play_alert_sound(self.entry_mp3_punish.get().strip())
                elif matched == "8page":
                    self.log(f"【警告】速度が8Page閾値({t2})未満です。")
                    play_alert_sound(self.entry_mp3_8page.get().strip())
                else:
                    self.log("速度は正常です。")
                    
        finally:
            self.last_valid_time = time.time()
            self._release_all_inputs()
            self.action_lock.release()

    def _osc_worker(self):
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try: sock.bind(("127.0.0.1", 9001))
        except Exception: return
        sock.settimeout(1.0)
        
        target_addr = "/avatar/parameters/VelocityMagnitude"
        while not self.stop_event.is_set():
            try:
                data, _ = sock.recvfrom(1024)
                val = parse_osc_float(data, target_addr)
                if val is not None:
                    self.current_velocity = val
                    if self.is_testing_speed:
                        self.max_velocity_during_test = max(self.max_velocity_during_test, val)
            except socket.timeout: pass
            except Exception: pass
        sock.close()


